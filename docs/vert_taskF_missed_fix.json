   ],
   "class": "ring",
   "number": 19,
   "situation": 1,
   "source_x": 377.8,
   "source_y": 333.0,
   "text": "出蔣竹山。19"
  },
  {
   "page": 1689,
   "col": [
    263.6,
    271.0,
    290.4,
    546.4
   ],
   "class": "ring",
   "number": 19,
   "situation": 1,
   "source_x": 276.8,
   "source_y": 526.0,
   "text": "八月二十日。娶李瓶兒過門。19"
  },
  {
   "page": 1690,
   "col": [
    245.3,
    232.0,
    268.6,
    811.9
   ],
   "class": "ring",
   "number": 20,
   "situation": 1,
   "source_x": 257.0,
   "source_y": 791.5,
   "text": "女們及嫖客丁二官等人，拴縛在門房內。多虧應伯爵等人勸住了。20"
  },
  {
   "page": 1690,
   "col": [
    145.9,
    236.3,
    167.8,
    794.5
   ],
   "class": "ring",
   "number": 21,
   "situation": 1,
   "source_x": 157.2,
   "source_y": 773.5,
   "text": "。孟玉樓提議由衆姊妹湊分資，辦桌酒席祝賀，共湊三兩一錢。21"
  },
  {
   "page": 1691,
   "col": [
    448.4,
    241.8,
    475.9,
    459.6
   ],
   "class": "ring",
   "number": 22,
   "situation": 1,
   "source_x": 464.0,
   "source_y": 439.5,
   "text": "，大罵賊王八調戲她。22"
  },
  {
   "page": 1692,
   "col": [
    470.2,
    245.0,
    497.0,
    345.8
   ],
   "class": "ring",
   "number": 25,
   "situation": 1,
   "source_x": 482.5,
   "source_y": 326.5,
